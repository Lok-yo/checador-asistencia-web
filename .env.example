# Copia este archivo como .env y completa los valores del proyecto de Supabase.
# Solo credenciales PÚBLICAS: clave publicable (sb_publishable_...) o anon.
# Nunca pongas aquí la clave service_role ni una clave secreta (sb_secret_...).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Zona IANA para calcular "hoy" y mostrar horas. Igual que la app móvil.
VITE_TIME_ZONE=America/Hermosillo
